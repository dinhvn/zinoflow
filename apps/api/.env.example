# ===== ZinoFlow API =====
# Copy file nay thanh .env va dien gia tri that. KHONG commit .env.

PORT=3001

# Auth gate: de trong = TAT (dev local). Dien gia tri = moi request can header x-api-token
API_TOKEN=
WEB_ORIGIN=http://localhost:3005

# PostgreSQL local (khong Docker). Tao database: CREATE DATABASE zinoflow;
# De trong thi API van boot duoc nhung cac tinh nang can DB se tat.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/zinoflow

# AI providers — chi can key cua provider ban dung
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# WordPress (Phase M4) — CHUA CO STAGING: day la site THAT (laruki.com/dochoi3s.com),
# chua co ban dev/staging rieng. App se log canh bao luc khoi dong neu dien gia tri
# that o day (xem modules/shared/observability/production-endpoint-warning.ts).
WP_LARUKI_URL=https://laruki.com
WP_LARUKI_USER=
WP_LARUKI_APP_PASSWORD=
WP_DOCHOI3S_URL=https://dochoi3s.com
WP_DOCHOI3S_USER=
WP_DOCHOI3S_APP_PASSWORD=

# CMS cu (.NET) — read-only API
CMS_BASE_URL=
CMS_API_KEY=

# ===== Image tool (product collage) =====
# CMS cu — search san pham (spec image-tool §12). Vd: https://localhost:5001
CMS_PRODUCT_API_BASE_URL=
CMS_PRODUCT_API_KEY=
# Bo qua cert self-signed khi goi CMS qua https localhost (CHI dev). Production de trong/false.
CMS_PRODUCT_API_INSECURE_TLS=false
# Base URL media neu CMS tra anh tuong doi (ghep thanh URL tuyet doi). De trong neu CMS da tra full URL.
CMS_MEDIA_BASE_URL=
# Thu muc luu anh da render (mac dinh ./outputs/images)
IMAGE_OUTPUT_DIR=./outputs/images

# Dichoithoi SQL Server — M4. KHONG commit gia tri that.
# Dev sandbox (LocalDB, Windows auth — user/password de trong):
#   DICHOITHOI_DB_HOST=(localdb)\MSSQLLocalDB
#   DICHOITHOI_DB_NAME=dichoithoi_dev
#   (tao sandbox: pnpm clone:dichoithoi roi chay 2 script trong scripts/dichoithoi-sqlserver)
# Production (site4now) — chi bat khi go-live:
DICHOITHOI_DB_HOST=
DICHOITHOI_DB_NAME=
DICHOITHOI_DB_USER=
DICHOITHOI_DB_PASSWORD=

# CMS khuyenmai (laruki + dochoi3s) SQL Server — luong content laruki/dochoi3s (spec laruki-dochoi3s-content-spec).
# AI tool ghi thang bang WordpressPost; CMS giu Init + Publish. KHONG commit gia tri that.
# CHUA CO SANDBOX RIENG (khac DICHOITHOI_DB da co ban LocalDB) — day la SQL Server
# production that (site4now). App se canh bao luc khoi dong neu dien gia tri that.
KHUYENMAI_DB_HOST=
KHUYENMAI_DB_NAME=
KHUYENMAI_DB_USER=
KHUYENMAI_DB_PASSWORD=

# Base URL anh diem den (spec §14.2) — duong dan Thumbnail trong DB la TUONG DOI
# (vd "nui-ham-rong-sapa.webp" hoac "diem-den/{slug}/thumb.webp"), full URL = base + path.
# Dung de nut "Kiem tra anh ton tai" (HEAD request) tren UI.
DICHOITHOI_IMAGE_BASE_URL=https://dichoithoi.com/diem-den/

# Thu muc local chua anh layout CU cua dichoithoi (repo DiChoiThoi.Web chay tren
# CUNG may voi zinoflow — local-first). Job migrate anh (§14.1.3) doc "{slug}.webp"
# thang tu day thay vi tai qua HTTP (URL live khong khop layout/duoi file thuc te).
DICHOITHOI_LOCAL_DIEM_DEN_DIR=D:\Gits\mmo\dichoithoi\DiChoiThoi.Web\contents\diem-den

# Chon noi day anh: "local" (ghi thang vao thu muc DiChoiThoi.Web tren may —
# dung khi dev/test, DiChoiThoi.Web cung chay local de thay anh ngay) hoac
# "ftp" (day len site4now production — mac dinh, giu hanh vi cu). CHU Y: de
# "ftp" trong luc dev se GHI DE anh that tren site dang live.
IMAGE_UPLOADER_PROVIDER=local

# Goc repo DiChoiThoi.Web tren may (chi dung khi IMAGE_UPLOADER_PROVIDER=local).
# Cac bien *_BASE_DIR ben duoi (FTP hoac local) deu la duong dan TUONG DOI voi
# goc nay, vd "contents/diem-den" -> ghi vao {root}/contents/diem-den.
DICHOITHOI_LOCAL_WEB_ROOT=D:\Gits\mmo\dichoithoi\DiChoiThoi.Web

# FTP upload anh diem den (spec §14.3 giai doan 2) — tab "Anh" keo-tha.
# BASE_DIR = thu muc tren hosting tro toi CUNG cho voi IMAGE_BASE_URL o tren
# (vd .../wwwroot/contents/diem-den). Path anh luu DB la TUONG DOI voi thu muc nay.
# SECURE=true = FTPS explicit TLS (mac dinh); dat false neu hosting chi FTP thuong.
# De trong = tinh nang upload TAT (van nhap path tay + kiem tra anh binh thuong).
# CHUA CO SANDBOX RIENG — day la FTP production that (site4now, cung host anh
# dang live). App se canh bao luc khoi dong neu dien gia tri that.
DICHOITHOI_FTP_HOST=
DICHOITHOI_FTP_PORT=21
DICHOITHOI_FTP_USER=
DICHOITHOI_FTP_PASSWORD=
DICHOITHOI_FTP_SECURE=true
DICHOITHOI_FTP_BASE_DIR=contents/diem-den

# Cung HOST/USER/PASSWORD o tren, moi module Hotel/Tour/Product co 1 thu muc
# goc RIENG tren hosting (ingest anh tu URL ngoai — destination-spec §14.5,
# backlog §B Phase C muc 3). De trong = tinh nang ingest anh cua module do TAT
# (giu tam URL nguon ngoai, khong chan luu — xem UpsertHotel/Tour/ProductUseCase).
DICHOITHOI_FTP_HOTEL_BASE_DIR=
DICHOITHOI_FTP_TOUR_BASE_DIR=
DICHOITHOI_FTP_PRODUCT_BASE_DIR=

# Thu vien anh noi dung (dichoithoi-content-image-library-plan.md §3.1) — doc lap
# hoan toan khoi anh diem den, dung chung IMAGE_UPLOADER_PROVIDER o tren.
DICHOITHOI_FTP_CONTENT_IMAGE_BASE_DIR=contents/noi-dung
# Base URL doc anh thu vien noi dung — path luu DB la TUONG DOI voi bien nay
# (vd "noi-dung/{uuid}.webp"), full URL = base + path.
DICHOITHOI_CONTENT_IMAGE_BASE_URL=https://dichoithoi.com/noi-dung/

# Tu dong tim anh minh hoa chung (dichoithoi-auto-image-search-plan.md) — API
# key mien phi dang ky tai pexels.com/api. De trong = tinh nang tim tu dong TAT
# (khong nem loi, chi tra ve 0 ket qua — xem PexelsStockImageSearchAdapter).
PEXELS_API_KEY=

# Purge cache website sau publish (Phase 17 — content-seo-ux-plan §10.5.1 muc 2).
# Tang 1: goi endpoint /api/remove-cache co san cua chinh website dichoithoi (KHONG
# phai SQL Server — day la URL HTTP toi app .NET dang chay).
# Dev: http://localhost:5176 . Production: https://dichoithoi.com
DICHOITHOI_SITE_BASE_URL=http://localhost:5176

# Tang 2 (Cloudflare Purge Cache API) — CHI bat khi da cau hinh DNS qua Cloudflare
# (§10.5.1 muc 1). De trong ca 3 dong duoi = tang 2 TAT, van purge tang 1 binh thuong.
DICHOITHOI_PUBLIC_BASE_URL=https://dichoithoi.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
