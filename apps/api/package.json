{
  "name": "@zinoflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "ZinoFlow API - NestJS + TypeORM + pg-boss (clean architecture)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "seed:dvhcvn": "ts-node scripts/seed-dvhcvn.ts",
    "check:dichoithoi": "ts-node scripts/check-dichoithoi-connection.ts",
    "check:khuyenmai": "ts-node scripts/check-khuyenmai-connection.ts",
    "clone:dichoithoi": "ts-node scripts/clone-dichoithoi-to-localdb.ts",
    "render:smoke": "ts-node scripts/render-image-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/genai": "^2.8.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@zinoflow/contracts": "workspace:*",
    "@zinoflow/image-compositions": "workspace:*",
    "dotenv": "^16.4.0",
    "marked": "^18.0.5",
    "msnodesqlv8": "^5.2.0",
    "mssql": "^12.5.5",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sanitize-html": "^2.17.5",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
